        },
        // FIPS-140-3 backend. Resolved ONLY under -Dfips=true (lazy). Pinned
        // to the published v0.1.1 tag -- matches the wal/tls/auth/quic
        // sibling repos. (Previously a `.path = "../fips"` placeholder that
        // only resolved on a dev machine with a sibling checkout; CI clones
        // only this repo, so `-Dfips=true` builds always failed there.)
        .fips = .{
            .url = "git+https://gitlab.com/devnw/zig/fips.git?ref=v0.1.3#f7395a3bab363d75b651be0775f43dd037c14a9c",
            .hash = "fips-0.1.3-1wf3natvCACgXCcDLw4o0KwZtrNNpXyyRp1hNIA9oi2m",
            .lazy = true,
        },
    },
