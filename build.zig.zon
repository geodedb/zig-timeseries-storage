    .dependencies = .{
        .wal = .{
            .url = "git+https://gitlab.com/devnw/zig/wal.git?ref=v0.1.24#acd8f6810decf5e3a9e6c9c3056c59003b7bca36",
            .hash = "wal-0.1.24-EqPqpuQPCABjGgoaO2lYjoNwcfM8d6Cvg04FdJTh3qkM",
        },
        .uuid = .{
            .url = "git+https://gitlab.com/devnw/zig/uuid.git?ref=c8206cbf2f3abc756b62b9e099715c81a452a2aa#c8206cbf2f3abc756b62b9e099715c81a452a2aa",
            .hash = "uuid-0.1.9-tL1iruPmHAAJ2ebApUBKroge9t-yDmrcPJ-2A2FEduNj",
        },
        .thread_pool = .{
            // LOCKSTEP with geode: geode passes its own *ThreadPool into
            // Engine.init, so this pin must be the exact thread_pool hash geode
            // pins. v0.2.10 carries the work-stealing data-race fixes (SONNY-6375);
            // v0.2.11 (SONNY-6479) is the revision geode and wal v0.1.24 pin.
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git?ref=v0.2.11#666b7ac0cc8b92d5773df5e79ea4fd421bd77e99",
            .hash = "thread_pool-0.2.11-11B1Bk2GegC5mn18xNrkmF0lMrgrWqijO7PXmftrkuSe",
        },
        // FIPS-140-3 backend. Resolved ONLY under -Dfips=true (lazy). Pinned
        // to the published v0.1.1 tag -- matches the wal/tls/auth/quic
        // sibling repos. (Previously a `.path = "../fips"` placeholder that
        // only resolved on a dev machine with a sibling checkout; CI clones
        // only this repo, so `-Dfips=true` builds always failed there.)
        .fips = .{
            .url = "git+https://gitlab.com/devnw/zig/fips.git?ref=v0.1.3#f7395a3bab363d75b651be0775f43dd037c14a9c",
            .hash = "fips-0.1.3-1wf3natvCACgXCcDLw4o0KwZtrNNpXyyRp1hNIA9oi2m",
            .lazy = true,
        },
    },
    .paths = .{
