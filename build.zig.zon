    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .wal = .{
            .url = "git+https://gitlab.com/devnw/zig/wal.git#v0.1.10",
            .hash = "wal-0.1.10-EqPqpmVXBQBAhgdSxswXYeWmr99V6neZMuSkUO2D380e",
        },
        .uuid = .{
            .url = "git+https://gitlab.com/devnw/zig/uuid.git?ref=v0.1.3#7a7c717e13500762f0d87d44bc402ba47d1d6099",
            .hash = "uuid-0.1.2-tL1irllLHABdG7QaL5h6WTNX5DrxSIzyxPozjsZMum9s",
        },
        .thread_pool = .{
            // Aligned with upstream geode main (post-d54fab4f) which pins
