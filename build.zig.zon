            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git?ref=v0.2.6#aa4493781d962f42ba1dd37261e0e107be5f6ffe",
            .hash = "thread_pool-0.2.5-11B1BiNceQDdiX2mLCg-blCuvBT0ZHh0_A_gH9j7t2Gl",
        },
        // FIPS-140-3 backend. Resolved ONLY under -Dfips=true (lazy). Local
        // path dep until the fips package is published; the eventual form is:
        //   .fips = .{
        //       .url = "git+https://gitlab.com/devnw/zig/fips.git?ref=v0.1.0#<sha>",
        //       .hash = "<zig-fetch-hash>",
        //       .lazy = true,
        //   },
        // Zig 0.16 rejects absolute .path values; this is the build-root-
        // relative path to /home/benji/src/devnw/zig/fips.
        .fips = .{
            .path = "../fips",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "Makefile",
        ".gitlab-ci.yml",
        "src",
        "tests",
        "examples",
        "benchmarks",
        "docs",
        "scripts",
        "LICENSE",
        "NOTICE",
        "README.md",
    },
}
