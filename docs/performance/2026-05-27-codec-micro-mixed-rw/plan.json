  "scenarios": [
    {
      "id": "gorilla_encode_256",
      "layer": "micro",
      "language": "zig",
      "source_file": "benchmarks/micro/codec.zig",
      "entry_point": "zig build bench-micro-codec -- --filter gorilla_encode_256",
      "ops_per_iteration": 256,
      "warmup_iterations": 2,
      "sample_iterations": 10,
      "metrics": [
        "wall_ns_p50",
        "wall_ns_stddev",
        "throughput_ops_per_sec",
        "alloc_count",
        "alloc_bytes",
        "peak_live_bytes"
      ],
      "concurrency_shapes": ["N=1"],
      "target_gain_pct": 5.0,
      "max_regression_pct": -3.0,
      "zero_alloc_expected": false,
      "zero_alloc_note": "GorillaEncoder.initForPoints allocates DynamicBitSet in setup; iteration itself must not re-alloc after initial capacity is reached. alloc_count > 1 after warmup indicates unexpected growth."
    },
    {
      "id": "gorilla_encode_4096",
