      "rss_peak_bytes"
    ]
  },
  "ci_placement": {
    "fast_ci_steps": [
      "bench",
      "bench-micro"
    ],
    "fast_ci_note": "bench-ci aggregates these two; wired to the existing benchmark-regression job (non-allow_failure). Runs on default branch push + schedule.",
    "scheduled_only_steps": [
      "bench-integration",
      "scale-bench"
    ],
    "scheduled_only_note": "bench-integration (concurrent and OoO scenarios, ~2-5 min) runs on schedule and manual trigger only. scale-bench likewise.",
    "smoke_steps": [
      "bench-smoke"
    ],
    "smoke_note": "bench-smoke runs on every push for all platforms including macOS M1 and Windows. Single sample, no regression gate, just a liveness check."
  },
  "cross_platform": {
    "linux_x86_64": {
      "status": "full bench suite + regression gate",
      "rss_fields": "populated from /proc/self/status"
    },
    "macos_aarch64": {
      "status": "bench-smoke only (liveness check)",
      "rss_fields": "zero (reporter.zig line 131)"
    },
    "windows_x86_64": {
      "status": "bench-smoke only (liveness check)",
      "rss_fields": "zero"
    }
  },
  "evidence_layout": {
    "run_dir_pattern": "docs/performance/2026-05-27-codec-micro-mixed-rw/runs/<YYYY-MM-DD>-<sha-A>-vs-<sha-B>/",
    "files": [
