    "bench-ab": "zig build bench-ab",
    "bench-compare": "zig build compare-bench -- --baseline docs/performance/2026-05-27-codec-micro-mixed-rw/runs/ref_a.json --current docs/performance/2026-05-27-codec-micro-mixed-rw/runs/ref_b.json",
    "bench-smoke": "zig build bench-smoke"
  },
  "ab_protocol": {
    "ref_a": "main",
    "ref_b": "HEAD",
    "warmups": 1,
    "rounds": 10,
    "stress_multiplier": 20,
    "variance_gate_formula": "max(floor_pct, 3.0 * (baseline_throughput_stddev / baseline_throughput) * 100)",
    "variance_gate_multiplier": 3.0,
    "fixed_floor_pct_initial": 15.0,
    "fixed_floor_pct_stable": 5.0,
    "fixed_floor_pct_tight": 3.0,
    "fixed_floor_note": "15% for first 3 CI runs per scenario; 5% after two stable baselines (stddev < 3%); 3% after five stable baselines with stddev < 1%. Matches compare.zig line 36 default and --floor override.",
    "target_gain_pct": 5.0,
    "max_regression_pct": -3.0,
    "first_run_expectation": "A == B medians within noise gate (sanity baseline; both refs are the same commit at design time)"
  },
  "build_step_preservation": {
    "must_not_rename": [
      "bench",
